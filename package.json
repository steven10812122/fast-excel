{
  "name": "fast-excel",
  "version": "0.1.0",
  "description": "Drag in a folder of Excel files with inconsistent layouts, match fields by keyword instead of fixed cell position, and consolidate them into one report.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --arm64"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fastexcel.app",
    "productName": "Fast Excel",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "publish": {
      "provider": "github",
      "owner": "steven10812122",
      "repo": "fast-excel"
    }
  }
}
